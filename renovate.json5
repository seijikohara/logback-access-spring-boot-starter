{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Shared policy: https://github.com/seijikohara/renovate-config
  extends: ["github>seijikohara/renovate-config:default.json5"],
  // `rebaseWhen: "conflicted"` overrides the inherited "behind-base-branch". Otherwise every
  // merge to main regenerates the lock file, which restarts the `minimumReleaseAge` countdown.
  // main moves almost daily, so the countdown never completed and the lock file pull request
  // stayed open for 53 days. The main ruleset does not require branches to be up to date, so a
  // slightly stale lock file branch still merges.
  lockFileMaintenance: {
    rebaseWhen: "conflicted",
  },
  packageRules: [
    {
      description: "Group the Spring ecosystem",
      groupName: "spring",
      matchPackageNames: ["/^org\\.springframework/"],
    },
    {
      description: "Group the test frameworks to reduce PR churn",
      groupName: "test frameworks",
      matchPackageNames: ["/^org\\.junit/", "/^io\\.kotest/", "/^org\\.assertj/"],
    },
  ],
}

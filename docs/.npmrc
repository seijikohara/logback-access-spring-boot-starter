# Install only npm package versions published at least 3 days ago, matching the
# 3-day hold in the shared Renovate preset (github.com/seijikohara/renovate-config).
# Renovate's own hold does not cover lock file maintenance or transitive
# dependencies, so npm enforces the hold whenever it resolves versions. With this
# key set, Renovate skips its own --before flag and leaves the hold to npm.
# A security fix newer than 3 days waits until it ages. Requires npm 11.10+.
min-release-age=3
